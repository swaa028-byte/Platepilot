# Public Supabase browser configuration (safe for browser; never use service role here)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Required only for trusted webhooks/worker operations.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
APP_URL=http://localhost:3000

# Server-only, API-restricted Places API (New) key. Leave empty for manual onboarding.
GOOGLE_PLACES_API_KEY=

# Set only through your deployment secret manager for provider verification.
PAYSTACK_TEST_SECRET_KEY=
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_SANDBOX_WEBHOOK_ID=

# Worker behavior
WORKER_POLL_MS=1000
WORKER_BATCH_SIZE=10
