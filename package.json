{
  "name": "platepilot",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm run messages:check && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:e2e": "playwright test",
    "worker": "tsx worker/index.ts",
    "messages:check": "tsx scripts/check-messages.ts",
    "e2e:clean": "node scripts/clean-e2e-data.mjs",
    "cf:build": "CLOUDFLARE_WORKERS=true opennextjs-cloudflare build",
    "preview": "pnpm run cf:build && opennextjs-cloudflare preview",
    "deploy": "pnpm run cf:build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@react-three/fiber": "9.8.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.1",
    "gsap": "3.12.5",
    "lucide-react": "1.76.0",
    "next": "16.4.6",
    "next-intl": "4.15.1",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "stripe": "23.2.0",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.18",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "27.4.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "^4.166.0"
  }
}
